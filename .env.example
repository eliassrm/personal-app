# Copy this file to ".env" and fill in your values.
# Create a "script" app at https://www.reddit.com/prefs/apps

# The string under the app name (looks like: p-a1B2c3D4e5F6g7)
REDDIT_CLIENT_ID=your_client_id_here

# The "secret" field of your app
REDDIT_CLIENT_SECRET=your_client_secret_here

# Your Reddit login
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Any descriptive string. Reddit asks that this identify your script + user.
REDDIT_USER_AGENT=windows:reddit-saves-archiver:v1.0 (by u/your_reddit_username)
